# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# RNFB (@react-native-firebase 26.4.1) defaults to Swift Package Manager on
# RN >= 0.75 — this project installs with CocoaPods, so opt out and use the
# documented static-frameworks combo. First `pod install` must log
# "SPM disabled"; if it does not, these flags are not being picked up.
$RNFirebaseDisableSPM = true
# Firebase pods built as static frameworks: dynamic linkage breaks the
# RN 0.87 pod set (reanimated fails dynamic-only), and RNFB documents
# static as the supported CocoaPods-mode combo with the flag above.
$RNFirebaseAsStaticFramework = true
# Firebase Analytics without AdSupport: the app declares "does not use
# advertising ID" on both stores — mirrors the Android AD_ID manifest strip.
$RNFirebaseAnalyticsWithoutAdIdSupport = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'FenzitApp' do
  # Google Maps provider for react-native-maps (attendance geofence map
  # picker, Epic 15+). Without this the pod installs only its default
  # Apple Maps subspec (`react-native-maps/Maps`) and `provider="google"`
  # fails at runtime. The subspec itself sets HAVE_GOOGLE_MAPS=1 and pins
  # GoogleMaps 9.4.0 + Google-Maps-iOS-Utils 6.1.0 — no manual macros.
  # Run `pod install` after changing this line.
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps/Google', :path => rn_maps_path

  config = use_native_modules!

  # Static linkage for every pod in this target — pinned, not env-dependent
  # (replaces the old USE_FRAMEWORKS conditional; required by the RNFB
  # static-frameworks combo above, before use_react_native!).
  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # RN 0.87's own floor (min_ios_version_supported) is 15.1 — pods must
        # not sit below the framework. Raise (never lower) to silence warnings.
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        # Apple-Silicon-only: drops the x86_64 slice for Intel/CI simulators.
        config.build_settings['ARCHS'] = 'arm64'
      end
    end
  end
end
