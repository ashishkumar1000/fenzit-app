<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Fenzit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Fenzit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Google Maps SDK key (react-native-maps — attendance office geofence
	     picker). Same key as android/keystore.properties FENZIT_MAPS_API_KEY
	     for the 15.1 spike; unrestricted — before launch restrict in Google
	     Cloud (iOS bundle id com.fenzit, API = Maps SDK for iOS). -->
	<key>GOOGLE_MAPS_API_KEY</key>
	<string>AIzaSyDE0COs1sKwQRoW1lwBdi9uJmNHFhSp55U</string>
	<!-- Only standard HTTPS/TLS + Apple crypto (FCM) = exempt; false answers
	     the per-build export-compliance questionnaire up front, so builds
	     never sit in "Missing Compliance". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Take photos of completed work</string>
	<!-- ITMS-90683: Apple's binary scan requires BOTH location keys because
	     react-native-nitro-geolocation references requestAlwaysAuthorization
	     in source, even though this app only ever punches in in the
	     foreground (index.js pins authorizationLevel to whenInUse). -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Your location is used only while the app is open, to verify where you punch in and out. Fenzit never tracks you in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fenzit uses your location to record where you complete jobs.</string>
	<key>NSMotionUsageDescription</key>
	<string>Fenzit does not collect motion or fitness data. A bundled location library references motion APIs for optional travel detection that Fenzit never enables.</string>
	<!-- Preemptive ITMS-90683: react-native-image-picker references
	     UIImageWriteToSavedPhotosAlbum in its compiled binary (saveToPhotos is
	     never enabled in this app) — the scanner flags symbol references, not
	     runtime calls, so declare the string before it emails us again. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save photos of completed work to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach photos of completed work</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!-- FCM pushes wake the app in background/quit via APNs (delivery
		     itself stays gated on Apple enrollment + the APNs key). -->
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>BootSplash</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
