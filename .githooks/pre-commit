#!/bin/sh
# Auto-fix, then verify, the app version across package.json, build.gradle
# and the pbxproj — see scripts/sync-version.js, scripts/verify-version-sync.js
# and scripts/check-store-downgrade.js (installed via `git config
# core.hooksPath .githooks` in the prepare script).

# 1. Never run during history rewrites — rebase and cherry-pick replay each
#    historical commit through this hook, and syncing would rewrite old
#    commits' version content to today's values. Skip silently instead.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] ||
  [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then
  exit 0
fi

# 2. GUI git clients and minimal shells often miss ~/.bun/bin.
PATH="$PATH:$HOME/.bun/bin"
command -v bun >/dev/null 2>&1 || {
  echo "pre-commit: bun not found on PATH — install bun or add it to PATH" >&2
  exit 1
}

# 3. The commit takes the index, but sync reads the worktree — if package.json
#    differs between the two, the commit could pair a staged version with
#    native files synced from the worktree version. Refuse and let the user
#    decide which copy is right.
if ! git diff --quiet -- package.json; then
  echo "pre-commit: package.json has unstaged changes — stage them (git add package.json) or discard them, then commit again" >&2
  exit 1
fi

# 3b. A version bump needs its own Play "What's new" text, written fresh. The
#     release workflow reads release-notes/<version>.txt, and Play rejects a
#     release with none. Checks the staged copies (what the commit will hold),
#     and refuses notes copied unchanged from the previous release.
version_of() {
  sed -n 's/^[[:space:]]*"version": "\([^"]*\)".*/\1/p' | head -n 1
}
staged_version=$(git show :package.json 2>/dev/null | version_of)
head_version=$(git show HEAD:package.json 2>/dev/null | version_of)
if [ -n "$staged_version" ] && [ "$staged_version" != "$head_version" ]; then
  notes="release-notes/$staged_version.txt"
  if ! git cat-file -e ":$notes" 2>/dev/null; then
    echo "pre-commit: version is moving to $staged_version — add $notes with the Play What's new text and stage it" >&2
    exit 1
  fi
  chars=$(git show ":$notes" | wc -m | tr -d ' ')
  if [ "$chars" -eq 0 ]; then
    echo "pre-commit: $notes is empty — write the What's new text" >&2
    exit 1
  fi
  if [ "$chars" -gt 500 ]; then
    echo "pre-commit: $notes is $chars characters — Play allows 500, shorten it" >&2
    exit 1
  fi
  # Same rule as the release workflow's CI gate: compare with the newest
  # other notes file (highest version) in the index.
  prev_notes=$(git ls-files 'release-notes/*.txt' | grep -vx "$notes" | sort -V | tail -n 1)
  if [ -n "$prev_notes" ] && [ "$(git show ":$notes")" = "$(git show ":$prev_notes")" ]; then
    echo "pre-commit: $notes is identical to $prev_notes — rewrite it for this release" >&2
    exit 1
  fi
fi

# 4. Never let a build number regress below one already uploaded to the
#    stores (recorded as store-v* tags — see scripts/check-store-downgrade.js).
#    Runs before sync so a doomed commit never rewrites the worktree.
bun scripts/check-store-downgrade.js || exit 1

# 5. Sync + verify.
sync_out=$(bun scripts/sync-version.js) || exit 1
echo "$sync_out"
bun scripts/verify-version-sync.js || exit 1

# 6. Re-stage exactly the files sync rewrote — never a blanket `git add` of the
# native files, which would sweep in unrelated unstaged edits (or clobber
# partial staging via `git add -p`). Note: if sync rewrote a file the user
# also edited by hand, `git add` stages that file whole, edits included.
# Kept in lockstep with sync-version.js's "rewrote <file>" output line.
rewritten=$(
  printf '%s\n' "$sync_out" |
    sed -n 's/^sync-version: rewrote \(.*\) → .*$/\1/p'
)
if [ -n "$rewritten" ]; then
  # shellcheck disable=SC2086 — the two synced paths never contain spaces
  git add $rewritten
fi
